{
	"name": "download-media-bot",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"check": "tsc --noEmit && eslint src && prettier src --check",
		"fix": "eslint src --fix && prettier src --write",
		"deploy": "wrangler deploy",
		"deploy:bot": "wrangler deploy -c wrangler.bot.jsonc",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"postinstall": "node scripts/gen-deploy-id.cjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.23.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.6",
		"eslint": "^10.14.0",
		"prettier": "^3.9.10",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^4.1.0",
		"wrangler": "^4.158.0"
	},
	"dependencies": {
		"grammy": "^1.46.0",
		"hono": "^4.13.16"
	}
}
