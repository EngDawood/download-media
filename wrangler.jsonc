{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "download-media-bot",
	"main": "src/index.ts",
	"build": {
		"command": "node scripts/gen-deploy-id.cjs"
	},
	"compatibility_date": "2026-02-10",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true,
			"invocation_logs": true
		},
		"traces": {
			"enabled": true,
			"persist": true,
			"head_sampling_rate": 1
		}
	},
	// KV namespace for download-media-bot state cache
	/*"kv_namespaces": [
		{
			"binding": "DOWNLOAD_CACHE",
			"id": "6769aec205aa4557ab05757c559c9618"
		}
	],*/
	
	"vars": {
		"ADMIN_TELEGRAM_ID": "801062947"
	},
	// Analytics Engine dataset for download statistics
	"analytics_engine_datasets": [
		{
			"binding": "ANALYTICS",
			"dataset": "ANALYTICS"
		}
	],
	"d1_databases": [
		{
			"binding": "download_media_bot_db",
			"database_name": "download-media-bot-db",
			"database_id": "db10a769-b0ed-438c-9e72-43fd687fbed3"
		}
	],
	// Custom Domain — Cloudflare creates the DNS record and issues the cert on deploy.
	// A Custom Domain routes *every* path to this Worker, so dl.engdawood.com serves
	// /mcp, /api/download, /telegram, /health and /setup alike. The workers.dev
	// subdomain keeps working alongside it.
	"routes": [
		{
			"pattern": "dl.engdawood.com",
			"custom_domain": true
		}
	]
	// Secrets (set via wrangler secret put):
	// - TELEGRAM_BOT_TOKEN
	// - TELEGRAM_WEBHOOK_SECRET
	// - TELEGRAPH_ACCESS_TOKEN
	// - PUBLIC_API_KEY  (enables POST /api/download and POST /mcp; both disabled if unset)
}